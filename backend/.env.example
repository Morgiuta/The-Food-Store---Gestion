# ==================== Database ====================
DATABASE_URL=postgresql://foodstore_user:foodstore_pass@localhost:5433/foodstore
# Format: postgresql://username:password@host:port/database

# ==================== Security ====================
SECRET_KEY=your-secret-key-of-at-least-64-characters-minimum-change-this-in-production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
ALGORITHM=HS256

# ==================== JWT Token ====================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== MercadoPago ====================
# Use TEST credentials for development
MP_ACCESS_TOKEN=TEST-your-mercadopago-access-token-here
MP_PUBLIC_KEY=TEST-your-mercadopago-public-key-here

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:3000"]

# ==================== Environment ====================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ==================== Server ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==================== Redis (optional, for caching) ====================
# REDIS_URL=redis://localhost:6379/0

# ==================== Email (optional) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SENDER_EMAIL=noreply@foodstore.com
